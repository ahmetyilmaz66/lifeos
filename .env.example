# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Gemini API key. Never use NEXT_PUBLIC_ for this value.
GEMINI_API_KEY=your-gemini-api-key

# Server-only. Used for account deletion (deleting the auth user + their storage files).
# From Supabase Dashboard > Project Settings > API > service_role key. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public VAPID key for Web Push (safe to expose — this is the "public" half of the pair).
# Generate the pair once (private half stays server-only, see below).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Not read by this Next.js app. Set these as Supabase Edge Function secrets ---
# (Dashboard > Edge Functions > send-reminders > Secrets, or `supabase secrets set`)
# RESEND_API_KEY=re_xxx              # from resend.com, used to send reminder emails
# CRON_SECRET=<random string>        # shared secret pg_cron sends in the x-cron-secret header
# RESEND_FROM_EMAIL=LifeOS <onboarding@resend.com>  # optional, once you verify a domain in Resend
# VAPID_PUBLIC_KEY=<same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY above>
# VAPID_PRIVATE_KEY=<private half of the VAPID pair — never expose to the client>
# VAPID_SUBJECT=mailto:you@yourdomain.com
