# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Gemini API key. Never use NEXT_PUBLIC_ for this value.
GEMINI_API_KEY=your-gemini-api-key

# --- Not read by this Next.js app. Set these as Supabase Edge Function secrets ---
# (Dashboard > Edge Functions > send-reminders > Secrets, or `supabase secrets set`)
# RESEND_API_KEY=re_xxx              # from resend.com, used to send reminder emails
# CRON_SECRET=<random string>        # shared secret pg_cron sends in the x-cron-secret header
# RESEND_FROM_EMAIL=LifeOS <onboarding@resend.com>  # optional, once you verify a domain in Resend
